# juice.${DOMAIN}: tinyauth has already authenticated the request and Traefik
# passed the username in Remote-User. Players and the organiser
# (${ADMIN_USER}) go to their own instance; anyone else to the scoreboard.
map $http_remote_user $pizza_instance {
    "~^(player[0-9]+)$" $1;
    "${ADMIN_USER}"     "${ADMIN_USER}";
    default             "";
}

server {
    listen 80;
    server_name _;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        if ($pizza_instance = "") {
            return 302 https://ctf.${DOMAIN}${PORT_SUFFIX}/;
        }
        return 302 https://$pizza_instance.${DOMAIN}${PORT_SUFFIX}/;
    }
}
