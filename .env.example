# pizza-hacking — ./pizza.sh writes the real .env on the first run.
# This file is only a reference; you never need to copy it.
# Values are generated once and never rotated.

DOMAIN=127.0.0.1.nip.io
HTTP_PORT=80
HTTPS_PORT=443
CTF_NAME=Pizza Hacking
JUICE_THEME=blue-lightblue
PLAYERS=1

# tinyauth (login in front of everything) — organiser account
TINYAUTH_ADMIN_USER=admin
TINYAUTH_ADMIN_PASSWORD=<generated>

# CTFd administrator — a different account from the one above
CTFD_ADMIN_USER=ctfadmin
CTFD_ADMIN_EMAIL=ctfadmin@pizza.invalid
CTFD_ADMIN_PASSWORD=<generated>

# Juice Shop flag key: flag = HMAC-SHA1(CTF_KEY, challenge name)
CTF_KEY=<generated>
CTFD_SECRET_KEY=<generated>
CTFD_DB_PASSWORD=<generated>
CTFD_DB_ROOT_PASSWORD=<generated>

# One line per player, added by ./pizza.sh up --players N
PLAYER1_PASSWORD=<generated>

# Optional: price of each CTFd hint, in percent of the challenge value
# HINT_COST_PERCENT=10
